APP_NAME= # Nome da aplicação (Para o Authenticator)

POSTGRES_HOST= # Host do PostgreSQL (ex: localhost, ou o nome do serviço no docker-compose)
POSTGRES_USER= # Usuário do container PostgreSQL (docker-compose)
POSTGRES_PASSWORD= # Senha do container PostgreSQL (docker-compose)
POSTGRES_DB= # Nome do banco do container PostgreSQL (docker-compose)
POSTGRES_PORT= # Porta exposta do container PostgreSQL (docker-compose)

REDIS_HOST= # Host do Redis
REDIS_PORT= # Porta do Redis (também usada pelo docker-compose)

MONGO_USERNAME= # Usuário do container do MongoDB
MONGO_PASSWORD= # Senha do container do MongoDB
MONGO_HOST= # Host do MongoDB (ex: localhost, ou o nome do serviço no docker-compose)
MONGO_PORT= # Port do container do MongoDB (docker-compose)
MONGO_DB= # Nome do banco do container MongoDB (docker-compose)

JWT_SECRET= # Chave secreta do JWT
TWO_FACTOR_SECRET_KEY= # Chave secreta do 2Factor
PEPPER_SECRET= # Chave secreta pelo PEPPER Methor

LOG_LEVEL=info